<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>CricClubs Overlay Auto-Reload</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, 0);
      overflow: hidden;
    }
    iframe {
      border: none;
      width: 100%;
      height: 100%;
    }
  </style>
</head>
<body>
  <iframe
    id="overlay"
    src="http://overlayscores.cricclubs.com:3000/overlay?fixtureId=2408&clubId=1106411"
    allowtransparency="true"
    scrolling="no"
  ></iframe>

  <script>
    setInterval(() => {
      const iframe = document.getElementById("overlay");
      iframe.src = iframe.src;
    }, 1000);
  </script>
</body>
</html>
